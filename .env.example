# Copy to `.env` and edit. Do NOT commit .env — only this example.
#
#   cp .env.example .env   (Linux/macOS)
#   copy .env.example .env (Windows)

# ----- Core Django -----
DEBUG=False
# Generate a new one:  python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=please-change-me-to-a-long-random-string
# Comma-separated. Add your real hostnames here.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ----- HTTP / TLS -----
# Set these True once you're serving HTTPS.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False

# ----- Email (Gmail SMTP) -----
# Use an app password, not your Google account password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=Kenya Community in Korea <your@gmail.com>

# ----- Exposed public port (host side) -----
PUBLIC_PORT=8000

# ----- Superuser auto-provision (first boot only) -----
# Leave blank to skip. Gets created/updated by the entrypoint script.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# ----- Postgres (only if you enable the db service via --profile postgres) -----
# POSTGRES_HOST=db
# POSTGRES_PORT=5432
# POSTGRES_DB=kck
# POSTGRES_USER=kck
# POSTGRES_PASSWORD=change-me

# ----- Sentry (error tracking — leave blank to disable) -----
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=v1.0.0
# SENTRY_TRACES_SAMPLE_RATE=0.1
